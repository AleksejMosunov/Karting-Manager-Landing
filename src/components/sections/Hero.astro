---
// Мокап — огляд адміна організації в темній темі адмінки
// (karting-manager/frontend/components/dashboard/OrgHome.tsx). Кольори — токени .dark з globals.css.
const C = {
  bg: '#060606',
  sidebar: '#0b0b0b',
  card: '#121212',
  border: 'rgba(255,255,255,0.09)',
  muted: '#8f8f8f',
  primary: '#3973ff',
  success: '#4bc680',
  warning: '#f5ae39',
};

const navSections = [
  {
    label: 'ОГЛЯД',
    items: [
      { label: 'Дашборд', active: true, icon: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z' },
      { label: 'Аналітика', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
      { label: 'CRM', icon: 'M3 4h18l-7 8v6l-4 2v-8L3 4z' },
    ],
  },
  {
    label: 'УПРАВЛІННЯ',
    items: [
      { label: 'Користувачі', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
      { label: 'Прокат', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
      { label: 'Гонки', icon: 'M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1zM4 22v-7' },
      { label: 'Академія', icon: 'M12 14l9-5-9-5-9 5 9 5zm0 0v6m-6-9v5c0 1 3 3 6 3s6-2 6-3v-5' },
      { label: 'Баланси клієнтів', icon: 'M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z' },
    ],
  },
  {
    label: 'ФІНАНСИ',
    items: [
      { label: 'Бонуси', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2' },
      { label: 'Фінанси', icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z' },
    ],
  },
  {
    label: 'СИСТЕМА',
    items: [
      { label: 'Налаштування', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065zM15 12a3 3 0 11-6 0 3 3 0 016 0z' },
    ],
  },
];

const attention = [
  { text: 'Броні сьогодні без оплати, а час уже настав: 2', hint: 'Візьміть оплату або позначте неявку' },
  { text: 'Баланси клієнтів згорять за 7 днів: 5', hint: 'сертифікати: 3 · пакети: 2' },
];

const tiles = [
  { label: 'Виручка сьогодні', value: '38 450 ₴', hint: '', delta: '+14 % до мин. тижня', tone: 'success' },
  { label: 'Чеки', value: '62', hint: 'середній 620 ₴', delta: '+9 % до мин. тижня', tone: 'success' },
  { label: 'Заповненість заїздів', value: '78 %', hint: '141 з 180 місць', delta: '+6 п.п. до мин. тижня', tone: 'success' },
  { label: 'Клієнти з покупкою', value: '54', hint: 'уперше: 11', delta: '−3 % до мин. тижня', tone: 'warning' },
];

// Виручка наростом: сьогодні (до 16:00) і той самий день тиждень тому.
const today = [0, 1.2, 3.1, 5.0, 8.4, 12.9, 17.2, 22.8, 29.6, 38.45];
const lastWeek = [0, 0.9, 2.4, 4.6, 7.1, 10.3, 14.8, 19.9, 25.1, 33.7, 41.2, 47.9, 52.3];
const W = 300, H = 70, maxV = 55, steps = 12;
const toPath = (arr: number[]) =>
  arr.map((v, i) => `${i === 0 ? 'M' : 'L'}${((i / steps) * W).toFixed(1)},${(H - (v / maxV) * H).toFixed(1)}`).join(' ');
const todayPath = toPath(today);
const todayArea = `${todayPath} L${(((today.length - 1) / steps) * W).toFixed(1)},${H} L0,${H} Z`;
const lastWeekPath = toPath(lastWeek);
const hours = ['10', '12', '14', '16', '18', '20', '22'];

const points = [
  { name: 'Арена Поділ', shift: 'зміна з 10:02 · Ірина', heat: 'наступний заїзд 16:10 · 6/8', revenue: '24 900 ₴' },
  { name: 'ТРЦ Ривʼєра', shift: 'зміна з 11:00 · Максим', heat: 'наступний заїзд 16:20 · 3/6', revenue: '13 550 ₴' },
];

const byType = [
  { label: 'Прокат', amount: '21 300 ₴', pct: 100 },
  { label: 'Гонки', amount: '7 800 ₴', pct: 37 },
  { label: 'Товари', amount: '4 150 ₴', pct: 19 },
  { label: 'Сертифікати', amount: '3 000 ₴', pct: 14 },
  { label: 'Академія', amount: '2 200 ₴', pct: 10 },
];
---

<section class="relative min-h-screen flex items-center overflow-hidden">
  <div class="absolute inset-0 bg-slate-900"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_20%_40%,rgba(57,115,255,0.15),transparent)]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_50%_40%_at_80%_70%,rgba(57,115,255,0.08),transparent)]"></div>
  <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:72px_72px]"></div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-20 lg:pt-28 lg:pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: text -->
      <div>
        <div class="inline-flex items-center gap-2 bg-brand-500/10 border border-brand-500/25 rounded-full px-4 py-1.5 mb-8" data-animate="fade-up">
          <span class="w-1.5 h-1.5 bg-brand-400 rounded-full animate-pulse"></span>
          <span class="text-brand-300 text-sm font-medium">Платформа для картинг-клубів</span>
        </div>

        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight mb-6 leading-[1.1]" data-animate="fade-up" data-animate-delay="1">
          Автоматизуйте<br/>
          <span class="bg-gradient-to-r from-brand-400 via-brand-300 to-cyan-400 bg-clip-text text-transparent">картинг-клуб.</span>
          <br/>Повністю.
        </h1>

        <p class="text-lg sm:text-xl text-slate-400 mb-4 leading-relaxed" data-animate="fade-up" data-animate-delay="2">
          Забудьте про Excel, дзвінки та ручний облік. Karting Manager замінює хаос із десятків інструментів — однією системою: від броні й черги заїздів до фіскального чека, зарплати та CRM.
        </p>
        <p class="text-sm text-slate-500 mb-10" data-animate="fade-up" data-animate-delay="2">
          Прокат і заїзди · Каса з Checkbox · Гонки й академія · Пакети та сертифікати · Лояльність · CRM · Фінанси
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mb-12" data-animate="fade-up" data-animate-delay="3">
          <a href="#contact" class="bg-brand-600 hover:bg-brand-500 text-white font-semibold px-8 py-4 rounded-xl transition-all duration-200 text-base shadow-lg shadow-brand-600/25 hover:shadow-brand-500/35 cursor-pointer text-center">
            Отримати безкоштовне демо
          </a>
          <a href="#features" class="bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-slate-300 hover:text-white font-semibold px-8 py-4 rounded-xl transition-all duration-200 text-base cursor-pointer text-center">
            Що вміє система
          </a>
        </div>

        <div class="flex flex-wrap gap-x-8 gap-y-4 pt-6 border-t border-white/5" data-animate="fade-up" data-animate-delay="4">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 bg-brand-600/20 rounded-lg flex items-center justify-center">
              <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            </div>
            <div>
              <div class="text-white font-bold text-lg leading-none">50+</div>
              <div class="text-slate-500 text-xs mt-0.5">клубів</div>
            </div>
          </div>
          <div class="w-px h-10 bg-white/10 self-center hidden sm:block"></div>
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 bg-brand-600/20 rounded-lg flex items-center justify-center">
              <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <div class="text-white font-bold text-lg leading-none">10 000+</div>
              <div class="text-slate-500 text-xs mt-0.5">бронювань/місяць</div>
            </div>
          </div>
          <div class="w-px h-10 bg-white/10 self-center hidden sm:block"></div>
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 bg-brand-600/20 rounded-lg flex items-center justify-center">
              <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <div>
              <div class="text-white font-bold text-lg leading-none">3 дні</div>
              <div class="text-slate-500 text-xs mt-0.5">до запуску</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: dashboard mockup (огляд адміна організації) -->
      <div class="hidden lg:block relative select-none" data-animate="fade-right" data-animate-delay="2">
        <div class="absolute -inset-4 bg-brand-600/10 rounded-3xl blur-2xl"></div>

        <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-black/50" style={`border:1px solid ${C.border}; background:${C.bg}; font-family:'Ubuntu',sans-serif;`}>
          <div class="flex" style="height:520px;">

            <!-- Sidebar -->
            <div class="w-[124px] shrink-0 flex flex-col" style={`background:${C.sidebar}; border-right:1px solid ${C.border};`}>
              <div class="flex justify-center py-1.5" style={`border-bottom:1px solid ${C.border};`}>
                <img src="/logo-light.png" alt="" class="h-9 w-auto" />
              </div>

              <nav class="flex-1 px-1.5 py-1 overflow-hidden">
                {navSections.map(section => (
                  <div>
                    <div class="px-1.5 pt-2 pb-0.5 uppercase tracking-widest font-semibold" style="font-size:6.5px; color:rgba(143,143,143,0.6);">{section.label}</div>
                    {section.items.map(item => (
                      <div class="relative flex items-center gap-1.5 px-1.5 py-[3.5px] rounded" style={`font-size:8.5px; ${item.active ? `background:rgba(57,115,255,0.12); color:${C.primary};` : `color:${C.muted};`}`}>
                        {item.active && <span class="absolute left-0 top-1/2 -translate-y-1/2 rounded-r" style={`width:1.5px; height:10px; background:${C.primary};`}></span>}
                        <svg class="shrink-0" style="width:9px;height:9px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/>
                        </svg>
                        <span class="truncate">{item.label}</span>
                      </div>
                    ))}
                  </div>
                ))}
              </nav>

              <div class="px-2 py-2" style={`border-top:1px solid ${C.border};`}>
                <div class="flex items-center gap-1.5">
                  <div class="w-5 h-5 rounded-full flex items-center justify-center shrink-0" style="background:rgba(57,115,255,0.15);">
                    <span class="font-bold" style={`font-size:6.5px; color:${C.primary};`}>КА</span>
                  </div>
                  <div class="min-w-0">
                    <div class="text-white font-medium truncate" style="font-size:7.5px;">Картинг Арена</div>
                    <div class="truncate" style={`font-size:6.5px; color:${C.muted};`}>Адміністратор</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Main area -->
            <div class="flex-1 flex flex-col overflow-hidden">

              <!-- Topbar -->
              <div class="flex items-center justify-between px-3 py-2" style={`background:${C.bg}; border-bottom:1px solid ${C.border};`}>
                <span style={`font-size:8.5px; color:${C.muted};`}>Дашборд</span>
                <div class="flex items-center gap-2">
                  <div class="flex items-center gap-1 px-2 py-0.5 rounded-md" style={`border:1px solid ${C.border};`}>
                    <svg style={`width:8px;height:8px;color:${C.muted};`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    <span style={`font-size:7.5px; color:${C.muted};`}>Пошук…</span>
                    <span style="font-size:6.5px; color:#5c5c5c; margin-left:4px;">⌘K</span>
                  </div>
                  <span style={`font-size:7.5px; color:${C.muted};`}>UA</span>
                  <div class="relative w-5 h-5 rounded-full flex items-center justify-center" style="background:rgba(57,115,255,0.15);">
                    <span class="font-bold" style={`font-size:6.5px; color:${C.primary};`}>КА</span>
                    <span class="absolute -top-px -right-px w-1.5 h-1.5 rounded-full" style={`background:${C.primary}; box-shadow:0 0 0 1.5px ${C.bg};`}></span>
                  </div>
                </div>
              </div>

              <!-- Content -->
              <div class="flex-1 p-3 overflow-hidden space-y-2">

                <!-- Page header -->
                <div class="flex items-end justify-between">
                  <div>
                    <div class="text-white font-bold" style="font-size:13px;">Дашборд</div>
                    <div style={`font-size:7.5px; color:${C.muted};`}>Ласкаво просимо, admin</div>
                  </div>
                  <div class="px-2 py-0.5 rounded-md text-white" style={`font-size:7.5px; border:1px solid ${C.border}; background:${C.card};`}>Усі точки ▾</div>
                </div>

                <!-- Потребує уваги -->
                <div class="rounded-lg px-2.5 py-1.5" style="background:rgba(245,174,57,0.07); border:1px solid rgba(245,174,57,0.25);">
                  <div class="flex items-center gap-1 font-semibold mb-1" style={`font-size:8px; color:${C.warning};`}>
                    <svg style="width:8px;height:8px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v4m0 4h.01M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z"/></svg>
                    Потребує уваги
                  </div>
                  <div class="grid grid-cols-2 gap-2">
                    {attention.map(a => (
                      <div>
                        <div class="text-white" style="font-size:7.5px;">{a.text}</div>
                        <div style={`font-size:6.5px; color:${C.muted};`}>{a.hint}</div>
                      </div>
                    ))}
                  </div>
                </div>

                <!-- Tiles -->
                <div class="grid grid-cols-4 gap-1.5">
                  {tiles.map(t => (
                    <div class="rounded-lg px-2 py-1.5 flex flex-col" style={`background:${C.card}; border:1px solid ${C.border};`}>
                      <div style={`font-size:7px; color:${C.muted};`}>{t.label}</div>
                      <div class="text-white font-semibold tracking-tight" style="font-size:13px;">{t.value}</div>
                      <div style={`font-size:6.5px; color:${C.muted}; min-height:8px;`}>{t.hint}</div>
                      <div class="mt-1 inline-flex self-start px-1 py-px rounded" style={`font-size:6px; ${t.tone === 'success' ? `background:rgba(75,198,128,0.12); color:${C.success};` : `background:rgba(245,174,57,0.12); color:${C.warning};`}`}>{t.delta}</div>
                    </div>
                  ))}
                </div>

                <!-- Hourly revenue -->
                <div class="rounded-lg px-2.5 py-2" style={`background:${C.card}; border:1px solid ${C.border};`}>
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="text-white font-semibold" style="font-size:8px;">Виручка наростом за день</span>
                    <div class="flex items-center gap-2" style={`font-size:6.5px; color:${C.muted};`}>
                      <span class="flex items-center gap-1"><span class="inline-block w-2 h-0.5 rounded" style={`background:${C.primary};`}></span>Сьогодні</span>
                      <span class="flex items-center gap-1"><span class="inline-block w-2 h-0.5 rounded" style="background:#5c5c5c;"></span>Тиждень тому</span>
                    </div>
                  </div>
                  <svg viewBox={`0 0 ${W} ${H}`} class="w-full" style="height:74px;" preserveAspectRatio="none">
                    <defs>
                      <linearGradient id="hero-rev" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color={C.primary} stop-opacity="0.35" />
                        <stop offset="100%" stop-color={C.primary} stop-opacity="0" />
                      </linearGradient>
                    </defs>
                    {[0.25, 0.5, 0.75].map(f => <line x1="0" x2={W} y1={H * f} y2={H * f} stroke="rgba(255,255,255,0.05)" stroke-width="0.6" />)}
                    <path d={lastWeekPath} fill="none" stroke="#5c5c5c" stroke-width="1.2" stroke-dasharray="3 2" vector-effect="non-scaling-stroke" />
                    <path d={todayArea} fill="url(#hero-rev)" />
                    <path d={todayPath} fill="none" stroke={C.primary} stroke-width="1.6" vector-effect="non-scaling-stroke" />
                  </svg>
                  <div class="flex justify-between mt-0.5" style="font-size:6px; color:#5c5c5c;">
                    {hours.map(h => <span>{h}:00</span>)}
                  </div>
                </div>

                <!-- Points + by type -->
                <div class="grid grid-cols-2 gap-1.5">
                  <div class="rounded-lg px-2.5 py-2" style={`background:${C.card}; border:1px solid ${C.border};`}>
                    <div class="text-white font-semibold mb-1.5" style="font-size:8px;">Зараз на точках</div>
                    <div class="space-y-1.5">
                      {points.map(p => (
                        <div class="flex items-start justify-between gap-1">
                          <div class="min-w-0">
                            <div class="flex items-center gap-1 text-white" style="font-size:7.5px;">
                              <span class="w-1 h-1 rounded-full" style={`background:${C.success};`}></span>{p.name}
                            </div>
                            <div style={`font-size:6.5px; color:${C.muted};`}>{p.shift}</div>
                            <div style={`font-size:6.5px; color:${C.muted};`}>{p.heat}</div>
                          </div>
                          <span class="text-white font-medium shrink-0" style="font-size:7.5px;">{p.revenue}</span>
                        </div>
                      ))}
                    </div>
                  </div>

                  <div class="rounded-lg px-2.5 py-2" style={`background:${C.card}; border:1px solid ${C.border};`}>
                    <div class="text-white font-semibold mb-1.5" style="font-size:8px;">Що продаємо сьогодні</div>
                    <div class="space-y-1">
                      {byType.map(b => (
                        <div>
                          <div class="flex justify-between" style="font-size:6.5px;">
                            <span style={`color:${C.muted};`}>{b.label}</span>
                            <span class="text-white">{b.amount}</span>
                          </div>
                          <div class="h-1 rounded-full mt-px" style="background:rgba(255,255,255,0.06);">
                            <div class="h-1 rounded-full" style={`width:${b.pct}%; background:${C.primary};`}></div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-slate-600">
    <svg class="w-5 h-5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>
