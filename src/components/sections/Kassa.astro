---
const fiscalItems = [
  { label: 'Прокат', desc: 'дорослий, дитячий, подвійний' },
  { label: 'Заїзди та гонки', desc: 'разові та групові старти' },
  { label: 'Академія', desc: 'тренування та абонементи' },
  { label: 'Сертифікати', desc: 'подарункові, з QR-кодом' },
  { label: 'Товари', desc: 'мерч, напої, аксесуари' },
  { label: 'Клубні карти', desc: 'абонементи та депозити' },
];

const timeSlots = [
  { time: '11:00', free: '8/8' },
  { time: '11:15', free: '8/8' },
  { time: '11:30', free: '8/8' },
  { time: '14:30', free: '8/8' },
  { time: '18:00', free: '8/8' },
  { time: '18:30', free: '5/8', low: true },
];

const queue = [
  { n: 30, time: '18:15', people: null },
  { n: 31, time: '18:30', people: 3 },
  { n: 32, time: '18:45', people: null },
];
---

<section id="kassa" class="pt-10 pb-10 bg-slate-900 relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_0%,rgba(99,102,241,0.08),transparent)]"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14" data-animate="fade-up">
      <div class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-1.5 mb-5">
        <span class="text-slate-400 text-sm font-medium">Робоче місце адміністратора</span>
      </div>
      <h2 class="text-4xl sm:text-5xl font-extrabold mb-4">
        Одна каса <span class="bg-gradient-to-r from-indigo-400 to-cyan-400 bg-clip-text text-transparent">на весь клуб</span>
      </h2>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto">
        Каса фіскалізує кожен продаж — прокат, заїзди, тренування академії, сертифікати, товари та клубні карти. Один чек, один інтерфейс, без перемикання між системами.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 mb-10">
      {fiscalItems.map((item, i) => (
        <div class="flex items-start gap-3 bg-white/[0.04] border border-white/10 rounded-xl px-4 py-3" data-animate="fade-up" data-animate-delay={(i % 3) + 1}>
          <div class="w-6 h-6 rounded-full bg-emerald-500/15 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
          </div>
          <div>
            <div class="text-white text-sm font-semibold leading-tight">{item.label}</div>
            <div class="text-slate-500 text-xs mt-0.5">{item.desc}</div>
          </div>
        </div>
      ))}
    </div>

    <!-- Real POS mockup -->
    <div class="hidden md:block relative select-none" data-animate="fade-up" data-animate-delay="2">
      <div class="absolute -inset-4 bg-indigo-600/8 rounded-3xl blur-2xl"></div>

      <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-black/50" style="border:1px solid rgba(255,255,255,0.08); background:#fafafa;">

        <!-- Top bar -->
        <div class="flex items-center justify-between px-4 py-2.5" style="background:#ffffff; border-bottom:1px solid #e5e7eb;">
          <div class="flex items-center gap-4">
            <div class="flex items-center gap-1.5">
              <div class="w-5 h-5 bg-indigo-600 rounded-md flex items-center justify-center shrink-0">
                <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <span class="font-bold" style="font-size:11px; color:#111827;">Каса</span>
            </div>
            <div class="flex items-center gap-1">
              <div class="px-2.5 py-1 rounded-md bg-indigo-600 text-white font-semibold" style="font-size:9px;">Продаж</div>
              <div class="px-2.5 py-1 rounded-md text-slate-500 font-medium" style="font-size:9px;">Готівка</div>
              <div class="px-2.5 py-1 rounded-md text-slate-500 font-medium" style="font-size:9px;">Чеки</div>
              <div class="px-2.5 py-1 rounded-md text-slate-500 font-medium" style="font-size:9px;">Зміна</div>
            </div>
          </div>
          <div class="flex items-center gap-3" style="font-size:8px;">
            <span class="flex items-center gap-1 text-slate-400"><span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>Каса не підключена</span>
            <span class="flex items-center gap-1 text-red-500"><span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>Друк офлайн</span>
            <span class="text-slate-400">← Адмін</span>
          </div>
        </div>

        <div class="flex" style="height:400px;">

          <!-- Cart -->
          <div class="w-[130px] shrink-0 p-3" style="background:#ffffff; border-right:1px solid #e5e7eb;">
            <div class="flex items-center gap-1 mb-3 text-slate-700 font-semibold" style="font-size:9px;">
              <svg style="width:10px;height:10px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
              Кошик
            </div>
            <div class="text-center text-slate-400 mt-8 leading-snug" style="font-size:8px;">Додайте позиції з каталогу</div>
          </div>

          <!-- Catalog -->
          <div class="flex-1 p-3 overflow-hidden" style="background:#fafafa;">
            <div class="flex items-center gap-3 mb-3 text-slate-500 font-medium" style="font-size:8.5px;">
              <span class="text-indigo-600 font-bold pb-1" style="border-bottom:1.5px solid #4f46e5;">Заїзди</span>
              <span>Події</span>
              <span>Товари</span>
              <span>Сертифікати</span>
              <span>Клубні карти</span>
            </div>

            <div class="grid grid-cols-3 gap-1.5 mb-3">
              <div class="rounded-lg p-2" style="background:#eef2ff; border:1.5px solid #4f46e5;">
                <div class="w-1.5 h-1.5 rounded-full bg-indigo-600 mb-1"></div>
                <div class="font-semibold text-slate-800" style="font-size:8px;">Прокат дорослий</div>
                <div class="text-slate-500 font-medium mt-0.5" style="font-size:8px;">600 ₴</div>
              </div>
              <div class="rounded-lg p-2" style="background:#ffffff; border:1px solid #e5e7eb;">
                <div class="w-1.5 h-1.5 rounded-full bg-slate-300 mb-1"></div>
                <div class="font-semibold text-slate-800" style="font-size:8px;">Прокат дитячий</div>
                <div class="text-slate-500 font-medium mt-0.5" style="font-size:8px;">550 ₴</div>
              </div>
              <div class="rounded-lg p-2" style="background:#ffffff; border:1px solid #e5e7eb;">
                <div class="w-1.5 h-1.5 rounded-full bg-slate-300 mb-1"></div>
                <div class="font-semibold text-slate-800" style="font-size:8px;">Прокат подвійний</div>
                <div class="text-slate-500 font-medium mt-0.5" style="font-size:8px;">600 ₴</div>
              </div>
            </div>

            <div class="text-slate-400 mb-1.5" style="font-size:7.5px;">Оберіть слот</div>
            <div class="grid grid-cols-6 gap-1">
              {timeSlots.map(slot => (
                <div class={`rounded-md text-center py-1 ${slot.low ? '' : ''}`} style={`background:#f0fdf4; border:1px solid #bbf7d0;`}>
                  <div class="font-semibold text-slate-800" style="font-size:7.5px;">{slot.time}</div>
                  <div class="text-emerald-600" style="font-size:6.5px;">{slot.free}</div>
                </div>
              ))}
            </div>
          </div>

          <!-- Queue -->
          <div class="w-[190px] shrink-0 p-3 overflow-hidden" style="background:#ffffff; border-left:1px solid #e5e7eb;">
            <div class="flex items-center justify-between mb-3">
              <span class="font-semibold text-slate-700" style="font-size:8.5px;">Черга заїздів</span>
              <span class="px-1.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700 font-semibold" style="font-size:7px;">36 активних</span>
            </div>
            <div class="space-y-1.5">
              {queue.map(q => (
                <div>
                  <div class="inline-block px-1.5 py-0.5 rounded bg-emerald-500 text-white font-semibold mb-1" style="font-size:6.5px;">Старт</div>
                  <div class="flex items-center justify-between">
                    <span class="text-slate-700 font-medium" style="font-size:7.5px;">Заїзд №{q.n}</span>
                    <span class="text-slate-400" style="font-size:6.5px;">{q.time}</span>
                  </div>
                  <div class="rounded-md mt-1 py-1.5 text-center" style="background:#f8fafc; border:1px dashed #e2e8f0;">
                    <span class="text-slate-400" style="font-size:6.5px;">{q.people ? `${q.people} учасники` : 'Учасників немає'}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </div>

    <p class="text-center text-slate-500 text-sm mt-6" data-animate="fade-up" data-animate-delay="3">
      Кожен чек одразу йде на фіскалізацію через Checkbox — незалежно від того, що продано: прокат, гонка, тренування академії чи подарунковий сертифікат.
    </p>
  </div>
</section>
