---
const plans = [
  {
    name: 'Старт',
    price: '6 500',
    period: 'грн/місяць',
    description: 'Весь операційний цикл клубу — бронювання, каса, лояльність',
    popular: false,
    cta: 'Почати',
    features: [
      'До 2 локацій в одній організації',
      'Бронювання трас + черга заїздів',
      'POS-каса з фіскалізацією (Checkbox)',
      'Академія: тренування та абонементи',
      'Подарункові сертифікати з QR-кодом',
      'Бонусна програма та клубні карти',
      'Базова аналітика',
      'Email-підтримка',
    ],
    missing: [
      'Розширена аналітика',
      'Мобільний застосунок для клієнтів',
      'Хронометраж заїздів',
    ],
  },
  {
    name: 'Бізнес',
    price: '11 500',
    period: 'грн/місяць',
    description: 'Все з тарифу Старт + доступ до хронометражу заїздів',
    popular: true,
    cta: 'Вибрати тариф',
    features: [
      'Все з тарифу Старт',
      'До 3 локацій в одній організації',
      'Розширена аналітика та звіти',
      'Мобільний застосунок для клієнтів',
      'Пріоритетна підтримка',
      'Можливість підключити хронометраж (окремо, за трасу)',
    ],
    missing: [],
  },
  {
    name: 'Ентерпрайз',
    price: 'Індивідуально',
    period: '',
    description: 'Мережа від 4 локацій — власні умови під ваш масштаб',
    popular: false,
    custom: true,
    cta: 'Зв\'язатися з нами',
    features: [
      'Все з тарифу Бізнес',
      '4+ локацій в одній організації',
      'Персональний менеджер',
      'Кастомні інтеграції та SLA',
    ],
    missing: [],
  },
];

const timingTiers = [
  {
    name: 'Базовий',
    price: '3 500',
    period: 'грн/місяць за трасу',
    note: 'Обов’язкова основа',
    features: [
      'Інтеграція з таймінг-хардвером на трасі',
      'Лап-таймінг та автофіксація часів',
      'Учасники та результати прокатних заїздів — автоматично в системі',
    ],
  },
  {
    name: 'Гонки',
    price: '3 000',
    period: 'грн/місяць за трасу',
    note: 'Додаток до Базового',
    features: [
      'Все з тарифу Базовий',
      'Проведення гонок: кваліфікація, суперфінал, фінал',
      'Командні гонки',
    ],
  },
  {
    name: 'Онлайн-тайминг',
    price: '3 000',
    period: 'грн/місяць за трасу',
    note: 'Додаток до Базового',
    features: [
      'Все з тарифу Базовий',
      'Результати доступні поза локальною мережею клубу',
      'Публічна сторінка результатів для гостей та вболівальників',
    ],
  },
];
---

<section id="pricing" class="pt-10 pb-10 bg-slate-900 relative overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_0%,rgba(99,102,241,0.1),transparent)]"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16" data-animate="fade-up">
      <div class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-1.5 mb-5">
        <span class="text-slate-400 text-sm font-medium">Прозорі ціни</span>
      </div>
      <h2 class="text-4xl sm:text-5xl font-extrabold mb-4">
        Обери свій тариф
      </h2>
      <p class="text-slate-400 text-lg max-w-xl mx-auto">
        Ціна за організацію, а не за адміністратора. Старт — до 2 локацій, Бізнес — до 3, більші мережі — за індивідуальними умовами.
      </p>
    </div>

    <!-- Plans -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {plans.map((plan, i) => (
        <div class={`relative rounded-2xl p-7 flex flex-col transition-all duration-300 ${
          plan.popular
            ? 'bg-indigo-950/50 border-2 border-indigo-500/60 shadow-xl shadow-indigo-500/10'
            : 'bg-white/[0.04] border border-white/10 hover:border-white/20'
        }`} data-animate="zoom-in" data-animate-delay={i + 1}>
          {/* Popular badge */}
          {plan.popular && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
              <span class="bg-indigo-600 text-white text-xs font-bold px-4 py-1 rounded-full whitespace-nowrap">
                Найпопулярніший
              </span>
            </div>
          )}

          <!-- Plan header -->
          <div class="mb-6">
            <h3 class={`text-xl font-bold mb-1 ${plan.popular ? 'text-indigo-300' : 'text-white'}`}>
              {plan.name}
            </h3>
            <p class="text-slate-500 text-sm">{plan.description}</p>
          </div>

          <!-- Price -->
          <div class="mb-7">
            <div class="flex items-baseline gap-1">
              <span class={plan.custom ? 'text-3xl font-extrabold text-white' : 'text-4xl font-extrabold text-white'}>{plan.price}</span>
              <span class="text-slate-400 text-sm">{plan.period}</span>
            </div>
          </div>

          <!-- CTA -->
          <a
            href="#contact"
            class={`block text-center font-semibold py-3 rounded-xl transition-all duration-200 mb-7 cursor-pointer ${
              plan.popular
                ? 'bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/25'
                : 'bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-slate-300 hover:text-white'
            }`}
          >
            {plan.cta}
          </a>

          <!-- Features -->
          <ul class="space-y-2.5 flex-1">
            {plan.features.map((f) => (
              <li class="flex items-start gap-2.5 text-sm">
                <svg class={`w-4 h-4 mt-0.5 flex-shrink-0 ${plan.popular ? 'text-indigo-400' : 'text-slate-400'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-300">{f}</span>
              </li>
            ))}
            {plan.missing.map((f) => (
              <li class="flex items-start gap-2.5 text-sm opacity-40">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span class="text-slate-500 line-through">{f}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Timing add-on -->
    <div class="mt-10 max-w-3xl mx-auto" data-animate="fade-up" data-animate-delay="3">
      <div class="rounded-2xl border border-indigo-500/25 bg-indigo-500/[0.04] p-7">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
          <h3 class="text-xl font-bold text-white">Хронометраж заїздів</h3>
          <span class="inline-flex items-center gap-1.5 bg-white/5 border border-white/10 rounded-full px-3 py-1 text-xs text-slate-400 font-medium">
            Доступно на тарифі Бізнес · окремо за кожну трасу
          </span>
        </div>
        <p class="text-slate-500 text-sm mb-6">
          Інтеграція з таймінг-хардвером на трасі (петлі, трансподери). Базовий — обов'язкова основа; Гонки та Онлайн-тайминг — незалежні один від одного додатки до нього. Ціна — за трасу, оскільки кожна траса підключається окремо.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-5">
          {timingTiers.map((tier) => (
            <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5">
              <div class="flex items-baseline justify-between mb-1">
                <span class="text-white font-semibold">{tier.name}</span>
                <div class="text-right">
                  <span class="text-2xl font-extrabold text-white">{tier.price}</span>
                  <span class="text-slate-500 text-xs block leading-tight">{tier.period}</span>
                </div>
              </div>
              <span class="text-indigo-400/70 text-xs font-medium block mb-3">{tier.note}</span>
              <ul class="space-y-2">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-2 text-sm">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-slate-300">{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="flex items-start gap-2.5 text-sm text-slate-500 pt-5 border-t border-white/10">
          <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Одноразовий setup 8 000–15 000 грн за трасу (підключення декодера та петель) — незалежно від обраного рівня.</span>
        </div>
      </div>
    </div>

    <!-- Worked example -->
    <div class="mt-6 max-w-3xl mx-auto" data-animate="fade-up" data-animate-delay="4">
      <div class="rounded-xl bg-white/[0.03] border border-white/5 px-6 py-4 text-sm text-slate-500">
        <span class="text-slate-400 font-medium">Приклад:</span> мережа з 3 трас на тарифі Бізнес, хронометраж (Базовий) потрібен на всіх трасах, гонки — на двох, а онлайн-тайминг — лише на одній:
        11 500 (Бізнес) + 3 500 × 3 (Базовий × 3 траси) + 3 000 × 2 (Гонки × 2 траси) + 3 000 × 1 (Онлайн-тайминг × 1 траса) = <span class="text-slate-300 font-semibold">31 000 грн/місяць</span>.
      </div>
    </div>

    <!-- FAQ note -->
    <p class="text-center text-slate-600 text-sm mt-10">
      Усі тарифи включають безкоштовне налаштування та онбординг.
      <a href="#contact" class="text-indigo-400 hover:text-indigo-300 transition-colors cursor-pointer ml-1">Маєте питання?</a>
    </p>
  </div>
</section>
