const roles = [
  {
    title: 'Власник і адміністратор',
    lead: 'Огляд клубу, а не таблиця цифр',
    points: [
      '«Потребує уваги»: забуті зміни, неоплачені броні, товари на мінімумі',
      'Виручка, чеки й заповненість проти того ж дня тиждень тому',
      'Завантаження треків, події тижня, останні чеки',
      'Модулі вмикаються в налаштуваннях — без зайвих пунктів меню',
    ],
    icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  },
  {
    title: 'Касир',
    lead: 'Робочий стіл зміни',
    points: [
      'Моя зміна: чеки, готівка й картка за сьогодні',
      'Найближчі заїзди з неоплаченими місцями',
      'Хто сьогодні приходить: броні, гонки, тренування, академія',
      'Бачить лише свою локацію та дозволені розділи',
    ],
    icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z',
  },
  {
    title: 'Маршал',
    lead: 'Черга на треку — з телефона',
    points: [
      'Склад заїзду та номери картів',
      'Пілоти, які не дійшли в таймінг, — одразу видно',
      'Особистий QR: клієнти, яких привів маршал, рахуються',
    ],
    icon: 'M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1zM4 22v-7',
  },
  {
    title: 'Клієнт',
    lead: 'Застосунок і онлайн-покупки',
    points: [
      'Вхід за SMS-кодом, бронювання заїздів, реєстрація на гонки',
      'Бонуси, пакети й клубні карти — у телефоні',
      'Купівля сертифікатів і клубних карт онлайн',
      'Push про бонуси, анонси гонок і нагадування',
